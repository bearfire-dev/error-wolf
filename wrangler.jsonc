{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "error-wolf",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  // Catches, reports, and rethrows uncaught exceptions to PostHog.
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Public project token. Overrides the build-time VITE_POSTHOG_KEY for the
    // Worker only, so a deployed Worker can point at another PostHog project
    // without a rebuild. Set POSTHOG_HOST too if you move off the US region.
    // "POSTHOG_KEY": "phc_...",
  },
}
