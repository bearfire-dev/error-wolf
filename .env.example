# --- Sentry (optional; omit all to run without Sentry) ---
# Use your own Sentry org/project/DSN when forking so events stay separate.

# HTTPS Client Keys DSN (browser + optional server fallback). Not an auth token (not sntrys_/sntryu_).
NEXT_PUBLIC_SENTRY_DSN=

# Same DSN for server/edge if you prefer not to expose NEXT_PUBLIC_* to server-only tooling only.
# Usually copy the same value as NEXT_PUBLIC_SENTRY_DSN or leave unset.
# SENTRY_DSN=

# Build: upload source maps and tie releases to your project (pnpm build / CI).
# Org slug + project slug from Sentry → Settings → (General) slug, not the display name.
SENTRY_ORG=
SENTRY_PROJECT=

# CI / VERCEL only:
# Organization Auth Token (sntrys_…) with release + read access for uploads — never commit real values.
# Paste in CI / Vercel env or gitignored .env.sentry-build-plugin; not for runtime DSN.
# SENTRY_AUTH_TOKEN=

# Overrides default environment tag (production/preview/development on Vercel). Optional.
# SENTRY_ENVIRONMENT=
