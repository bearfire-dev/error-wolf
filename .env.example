# --- Site ---
# Canonical origin for metadata, robots, and the sitemap. Optional in development.
# VITE_SITE_URL=https://errorwolf.dev

# --- Sentry (optional; omit all to run without Sentry) ---
# Use your own Sentry org/project/DSN when forking so events stay separate.

# HTTPS Client Keys DSN. Not an auth token (not sntrys_/sntryu_).
# Vite inlines this into the browser bundle and the Worker bundle at build time.
# A DSN is public by design.
VITE_SENTRY_DSN=

# Overrides the environment tag in Sentry. Defaults to the Vite mode. Optional.
# VITE_SENTRY_ENVIRONMENT=

# Build: upload source maps and tie releases to your project (pnpm build / CI).
# Org slug and project slug from Sentry -> Settings -> (General) slug, not the display name.
SENTRY_ORG=
SENTRY_PROJECT=

# CI only:
# Organization Auth Token (sntrys_...) with release and read access for uploads.
# Never commit a real value. Put it in the GitHub Actions secrets or in the
# gitignored .env.sentry-build-plugin file. It is not a runtime DSN.
# SENTRY_AUTH_TOKEN=

# --- Cloudflare Worker runtime (optional) ---
# Set these with `wrangler secret put` to override the build-time Sentry values
# on a deployed Worker without a rebuild.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
